{
  "name": "can_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-intl": "^12.1.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --web --port 8081",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest --ci",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "gen:api": "npx --yes -p typescript@5 -p openapi-typescript@7.13.0 openapi-typescript ../can_server/openapi/openapi.json -o src/api/schema.d.ts",
    "check:logical": "node scripts/check-logical.mjs",
    "build:web": "expo export --platform web --output-dir dist",
    "verify": "tsc --noEmit && expo lint && prettier --check . && node scripts/check-logical.mjs && jest --ci && expo export --platform web --output-dir dist"
  },
  "private": true,
  "license": "MIT",
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
